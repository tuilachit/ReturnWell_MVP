# Server-only values. Never copy these names into NEXT_PUBLIC variables.
# Supabase supplies SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY to deployed functions.
EMAIL_DELIVERY_ENABLED=false
RELEASE_MODE=private_test
# Set true in any restored environment until independently reconciled.
RESTORE_QUARANTINE=false
APP_URL=
WEBSITE_URL=
RETURNWELL_BUSINESS_NAME=
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
PRIVACY_VERSION=
TERMS_VERSION=
ALLOWED_ORIGINS=
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_WORKER_SECRET=
# Base64-encoded random 32-byte AES key, and its non-secret rotation identifier.
INVITATION_ENCRYPTION_KEY=
INVITATION_KEY_ID=
# Optional JSON map of previous key IDs to base64 keys, retained through expiry.
INVITATION_PREVIOUS_KEYS={}
# Exact named approved recipients, also during the bounded pilot. Blank DISABLES sending.
EMAIL_TEST_ALLOWLIST=
