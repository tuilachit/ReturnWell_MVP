# Safe browser configuration. Never place a service-role key in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Keep false until the ReturnWell sender domain and server-only Resend secrets are configured.
NEXT_PUBLIC_EMAIL_DELIVERY_ENABLED=false

# Canonical site URL for page metadata; set to the deployed HTTPS URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron -> Supabase email worker bridge. Server-only; never use NEXT_PUBLIC_ here.
CRON_SECRET=
SUPABASE_URL=https://your-project.supabase.co
EMAIL_WORKER_SECRET=
